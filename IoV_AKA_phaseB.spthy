/*
 * Tamarin model of the proposed authentication protocol for 6G-assisted
 * fog-computing-based Internet of Vehicles (IoV).
 *
 *   Phase A (full authentication, via the cloud):
 *       M1 V->F,  M2 F->CS,  M3 CS->F,  M4 F->V      (session key SK)
 *   Phase B (cloud-free fog handover authentication):
 *       M5 V->F', M6 F'->V                            (session key SK')
 *
 * Adversary: Dolev-Yao network adversary extended with the Canetti-Krawczyk
 *            (CK) queries Corrupt (long-term state of an entity) and
 *            ESReveal (per-session ephemeral randomness r_1,...,r_5).
 *
 * Modelling choices (abstractions):
 *  - Scalar multiplication x.P is modelled with Tamarin's built-in
 *    Diffie-Hellman theory as P^x (computational DH assumptions).
 *  - Ephemeral scalars follow the NAXOS construction x = h(r || S).
 *  - The static keys k_ic = h(S_Vi.P_c) and k_jc = h(S_Fj.P_c) are computed
 *    once at registration; they are modelled as fresh values shared between
 *    the entity and CS and are revealed by corrupting either endpoint.
 *  - The pairwise polynomial key k_ij = f(VID_i, FID_j) is the private
 *    function poly/2. It is revealed by corrupting V_i (row share), F_j
 *    (column share) or CS (holder of f). Coalitions that exceed the degree
 *    of f, and could interpolate it, are outside the model.
 *  - The one-time pad N_c = h(.) XOR SK is modelled as symmetric encryption
 *    of SK under the mask h(.).
 *  - Timestamps are abstracted away; the replay caches kept by the fog
 *    nodes and CS within the freshness window are modelled by uniqueness
 *    restrictions on the received ephemeral public keys.
 */

// This file: shared setup, registration, and adversary rules with phase B only.

theory IoV_AKA_phaseB
begin

builtins: diffie-hellman, hashing, symmetric-encryption

functions: poly/2 [private]

/* ------------------------------------------------------------------ */
/* Restrictions                                                       */
/* ------------------------------------------------------------------ */

restriction OnlyOnceCS:
  "All #i #j. CSSetup() @ #i & CSSetup() @ #j ==> #i = #j"

restriction FogReplayCache:
  "All fid R #i #j. F_Cache(fid, R) @ #i & F_Cache(fid, R) @ #j ==> #i = #j"

/* ------------------------------------------------------------------ */
/* Setup and registration (secure channel)                            */
/* ------------------------------------------------------------------ */

rule CS_Setup:
    [ Fr(~sc) ]
  --[ CSSetup() ]->
    [ !LtkC(~sc), !PkC('g'^~sc), Out('g'^~sc) ]

// F_j generates its own key pair (no key escrow)
rule Fog_Register:
    [ Fr(~fid), Fr(~sf), Fr(~kjc), !PkC(pc) ]
  --[ FogLtk(~fid, ~sf), FogKey(~fid, ~kjc) ]->
    [ !LtkF(~fid, ~sf, ~kjc), !PkF(~fid, 'g'^~sf), !RegF(~fid, ~kjc),
      Out(<~fid, 'g'^~sf>) ]

// V_i generates its own key pair (no key escrow)
rule Vehicle_Register:
    [ Fr(~vid), Fr(~sv), Fr(~kic), !PkC(pc) ]
  --[ VehLtk(~vid, ~sv), VehKey(~vid, ~kic) ]->
    [ !LtkV(~vid, ~sv, ~kic), !RegV(~vid, ~kic) ]

/* ------------------------------------------------------------------ */
/* CK adversary: Corrupt and ESReveal queries                         */
/* ------------------------------------------------------------------ */

rule Corrupt_V:
    [ !LtkV(~vid, ~sv, ~kic) ] --[ RevV(~vid) ]-> [ Out(<~vid, ~sv, ~kic>) ]

rule Corrupt_V_share:      // share f(VID_i, y), evaluated at any fog node
    [ !LtkV(~vid, ~sv, ~kic), !PkF(~fid, pf) ] --[ RevV(~vid) ]-> [ Out(poly(~vid, ~fid)) ]

rule Corrupt_F:
    [ !LtkF(~fid, ~sf, ~kjc) ] --[ RevF(~fid) ]-> [ Out(<~sf, ~kjc>) ]

rule Corrupt_F_share:      // share f(x, FID_j), evaluated at any vehicle
    [ !LtkF(~fid, ~sf, ~kjc), !RegV(~vid, kic) ] --[ RevF(~fid) ]-> [ Out(poly(~vid, ~fid)) ]

rule Corrupt_CS:
    [ !LtkC(~sc) ] --[ RevC() ]-> [ Out(~sc) ]

rule Corrupt_CS_db:        // registry entries and the polynomial f(x, y)
    [ !LtkC(~sc), !RegV(~vid, ~kic), !RegF(~fid, ~kjc) ]
  --[ RevC() ]->
    [ Out(<~kic, ~kjc, poly(~vid, ~fid)>) ]

rule ESReveal_V:  [ !EphV(~vid, R, ~e) ] --[ RevEphV(~vid, R) ]-> [ Out(~e) ]

rule ESReveal_F:  [ !EphF(~fid, R, ~e) ] --[ RevEphF(~fid, R) ]-> [ Out(~e) ]


/* ------------------------------------------------------------------ */
/* Phase B: cloud-free handover authentication                        */
/* ------------------------------------------------------------------ */

// Step H1: V_i -> F_k : M5 = {R4, C3, sigma_4, T5}
rule VH_1:
    let x4   = h(<'nx', ~e4, ~sv>)
        R4   = 'g'^x4
        Q4   = pf^x4
        K3   = h(<'K3', Q4, R4>)
        kik  = poly(~vid, ~fid)
        sig4 = h(<'sig4', kik, ~vid, ~fid, R4>)
    in
    [ !LtkV(~vid, ~sv, ~kic), !PkF(~fid, pf), Fr(~e4) ]
  --[ VH_Start(~vid, ~fid, R4) ]->
    [ VH_St(~vid, ~fid, ~e4, ~sv, R4, Q4), !EphV(~vid, R4, ~e4),
      Out(<R4, senc(~vid, K3), sig4>) ]

// Step H2: F_k authenticates V_i with k_ik = f(VID_i, FID_k) and replies
//          M6 = {R5, d5, T6}
rule FH_1:
    let Q4   = R4^~sf
        K3   = h(<'K3', Q4, R4>)
        kik  = poly(~vid, ~fid)
        x5   = h(<'nx', ~e5, ~sf>)
        R5   = 'g'^x5
        Z    = R4^x5
        SKh  = h(<'SKh', kik, ~vid, ~fid, R4, R5, Z, Q4>)
        d5   = h(<'d5', SKh, R4, R5>)
    in
    [ !LtkF(~fid, ~sf, ~kjc), Fr(~e5),
      In(<R4, senc(~vid, K3), h(<'sig4', kik, ~vid, ~fid, R4>)>) ]
  --[ F_Cache(~fid, R4), FH_Accept(~fid, ~vid, R4, R5, SKh) ]->
    [ !EphF(~fid, R5, ~e5), Out(<R5, d5>) ]

// Step H3: V_i derives SK' and verifies d5
rule VH_2:
    let x4   = h(<'nx', ~e4, ~sv>)
        Z    = R5^x4
        kik  = poly(~vid, ~fid)
        SKh  = h(<'SKh', kik, ~vid, ~fid, R4, R5, Z, Q4>)
    in
    [ VH_St(~vid, ~fid, ~e4, ~sv, R4, Q4), In(<R5, h(<'d5', SKh, R4, R5>)>) ]
  --[ VH_Accept(~vid, ~fid, R4, R5, SKh) ]->
    [ ]

/* ------------------------------------------------------------------ */
/* Helper lemmas: long-term secrets                                   */
/* ------------------------------------------------------------------ */

lemma ltk_V [reuse]:
  "All vid sv #i #j. VehLtk(vid, sv) @ #i & KU(sv) @ #j
     ==> Ex #r. RevV(vid) @ #r & #r < #j"

lemma ltk_F [reuse]:
  "All fid sf #i #j. FogLtk(fid, sf) @ #i & KU(sf) @ #j
     ==> Ex #r. RevF(fid) @ #r & #r < #j"

lemma key_ic [reuse]:
  "All vid k #i #j. VehKey(vid, k) @ #i & KU(k) @ #j
     ==> (Ex #r. RevV(vid) @ #r & #r < #j) | (Ex #r. RevC() @ #r & #r < #j)"

lemma key_jc [reuse]:
  "All fid k #i #j. FogKey(fid, k) @ #i & KU(k) @ #j
     ==> (Ex #r. RevF(fid) @ #r & #r < #j) | (Ex #r. RevC() @ #r & #r < #j)"

lemma key_ij [reuse]:
  "All vid fid #j. KU(poly(vid, fid)) @ #j
     ==> (Ex #r. RevV(vid) @ #r & #r < #j) | (Ex #r. RevF(fid) @ #r & #r < #j)
       | (Ex #r. RevC() @ #r & #r < #j)"

/* ------------------------------------------------------------------ */
/* Executability                                                      */
/* ------------------------------------------------------------------ */

lemma exec_phaseB:
  exists-trace
  "Ex vid fid R4 R5 SK #i #j.
      FH_Accept(fid, vid, R4, R5, SK) @ #i & VH_Accept(vid, fid, R4, R5, SK) @ #j
    & not (Ex v #r. RevV(v) @ #r) & not (Ex f #r. RevF(f) @ #r)
    & not (Ex #r. RevC() @ #r)"

/* ------------------------------------------------------------------ */
/* Phase B: authentication (reused in the secrecy proofs)             */
/* ------------------------------------------------------------------ */

lemma authB_V_F [reuse]:
  "All vid fid R4 R5 SK #i.
      VH_Accept(vid, fid, R4, R5, SK) @ #i
   ==>
      (Ex #j. FH_Accept(fid, vid, R4, R5, SK) @ #j & #j < #i)
    | (Ex #a. RevF(fid) @ #a & #a < #i)
    | (Ex #a #b. RevV(vid) @ #a & RevEphV(vid, R4) @ #b)"

lemma authB_F_V [reuse]:
  "All vid fid R4 R5 SK #i.
      FH_Accept(fid, vid, R4, R5, SK) @ #i
   ==>
      (Ex #j. VH_Start(vid, fid, R4) @ #j & #j < #i)
    | (Ex #a. RevV(vid) @ #a & #a < #i)
    | (Ex #a. RevF(fid) @ #a & #a < #i)
    | (Ex #a. RevC() @ #a & #a < #i)"

/* ------------------------------------------------------------------ */
/* Phase B: session-key secrecy (PFS and ephemeral-secret leakage)    */
/* ------------------------------------------------------------------ */

lemma secB_vehicle:
  "All vid fid R4 R5 SK #i #j.
      VH_Accept(vid, fid, R4, R5, SK) @ #i & K(SK) @ #j
   ==>
      (Ex #a #b. RevV(vid) @ #a & RevEphV(vid, R4) @ #b)
    | (Ex #a #b. RevF(fid) @ #a & RevEphF(fid, R5) @ #b)
    | (Ex #a. RevF(fid) @ #a & #a < #i)"

lemma secB_fog:
  "All vid fid R4 R5 SK #i #j.
      FH_Accept(fid, vid, R4, R5, SK) @ #i & K(SK) @ #j
   ==>
      (Ex #a #b. RevF(fid) @ #a & RevEphF(fid, R5) @ #b)
    | (Ex #a #b. RevV(vid) @ #a & RevEphV(vid, R4) @ #b)
    | (Ex #a. RevV(vid) @ #a & #a < #i)
    | (Ex #a. RevF(fid) @ #a & #a < #i)
    | (Ex #a. RevC() @ #a & #a < #i)"

/* ------------------------------------------------------------------ */
/* Anonymity                                                          */
/* ------------------------------------------------------------------ */

lemma anonymity:
  "All vid sv #i #j. VehLtk(vid, sv) @ #i & K(vid) @ #j
   ==>
      (Ex #a. RevV(vid) @ #a)
    | (Ex #a. RevC() @ #a)
    | (Ex f R #a #b. VH_Start(vid, f, R) @ #b & RevF(f) @ #a)"

end
