  // safety formula

rule (modulo E) CS_Setup:
   [ Fr( ~sc ) ]
  --[ CSSetup( ) ]->
   [ !LtkC( ~sc ), !PkC( 'g'^~sc ), Out( 'g'^~sc ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Fog_Register:
   [ Fr( ~fid ), Fr( ~sf ), Fr( ~kjc ), !PkC( pc ) ]
  --[ FogLtk( ~fid, ~sf ), FogKey( ~fid, ~kjc ) ]->
   [
   !LtkF( ~fid, ~sf, ~kjc ), !PkF( ~fid, 'g'^~sf ), !RegF( ~fid, ~kjc ),
   Out( <~fid, 'g'^~sf> )
