lemma ltk_V [reuse]:
  all-traces
  "∀ vid sv #i #j.
    ((VehLtk( vid, sv ) @ #i) ∧ (!KU( sv ) @ #j)) ⇒
    (∃ #r. (RevV( vid ) @ #r) ∧ (#r < #j))"
/*
guarded formula characterizing all counter-examples:
"∃ vid sv #i #j.
  (VehLtk( vid, sv ) @ #i) ∧ (!KU( sv ) @ #j)
 ∧
  ∀ #r. (RevV( vid ) @ #r) ⇒ ¬(#r < #j)"
*/
by sorry

