rule (modulo E) F_3:
   [
   F_St2( ~fid, ~vid, ~e2, ~sf, ~kjc, R1, R2, Q1, Q2 ),
   In( <R3, Nc, 
        h(<'d1', 
           h(<'SK', h(<'h2', ~vid, ~fid, R1, R3>), R3^h(<'nx', ~e2, ~sf>), Q2>), 
           ~kjc, h(<'h2', ~vid, ~fid, R1, R3>)>)
       >
   )
   ]
  --[
  F_Accept( ~fid, ~vid, R1, R2, R3,
            h(<'SK', h(<'h2', ~vid, ~fid, R1, R3>), R3^h(<'nx', ~e2, ~sf>), Q2>)
  )
  ]->
   [
   Out( <R3, Nc, 
         h(<'d3', 
            h(<'SK', h(<'h2', ~vid, ~fid, R1, R3>), R3^h(<'nx', ~e2, ~sf>), Q2>), 
            Q1, h(<'h2', ~vid, ~fid, R1, R3>)>)
        >
   )
   ]

