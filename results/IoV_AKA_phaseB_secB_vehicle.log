lemma exec_phaseB:
  exists-trace
  "∃ vid fid R4 R5 SK #i #j.
    ((((FH_Accept( fid, vid, R4, R5, SK ) @ #i) ∧
       (VH_Accept( vid, fid, R4, R5, SK ) @ #j)) ∧
      (¬(∃ v #r. RevV( v ) @ #r))) ∧
     (¬(∃ f #r. RevF( f ) @ #r))) ∧
    (¬(∃ #r. RevC( ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ vid fid R4 R5 SK #i #j.
  (FH_Accept( fid, vid, R4, R5, SK ) @ #i) ∧
  (VH_Accept( vid, fid, R4, R5, SK ) @ #j)
 ∧
  (∀ v #r. (RevV( v ) @ #r) ⇒ ⊥) ∧
  (∀ f #r. (RevF( f ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (RevC( ) @ #r) ⇒ ⊥)"
*/
by sorry

