lemma exec_phaseA:
  exists-trace
  "∃ vid fid R1 R2 R3 SK #i #j #k.
    (((((CS_Accept( vid, fid, R1, R2, R3, SK ) @ #i) ∧
        (F_Accept( fid, vid, R1, R2, R3, SK ) @ #j)) ∧
       (V_Accept( vid, fid, R1, R3, SK ) @ #k)) ∧
      (¬(∃ v #r. RevV( v ) @ #r))) ∧
     (¬(∃ f #r. RevF( f ) @ #r))) ∧
    (¬(∃ #r. RevC( ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ vid fid R1 R2 R3 SK #i #j #k.
  (CS_Accept( vid, fid, R1, R2, R3, SK ) @ #i) ∧
  (F_Accept( fid, vid, R1, R2, R3, SK ) @ #j) ∧
  (V_Accept( vid, fid, R1, R3, SK ) @ #k)
 ∧
  (∀ v #r. (RevV( v ) @ #r) ⇒ ⊥) ∧
  (∀ f #r. (RevF( f ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (RevC( ) @ #r) ⇒ ⊥)"
*/
simplify
solve( F_St2( ~fid, ~vid, ~e2, ~sf, ~kjc.1, R1, 'g'^h(<'nx', ~e2, ~sf>),
              Q1, Q2
       ) ▶₀ #j )
  case F_2
  solve( CS_St1( ~sc, ~vid, ~fid, ~kic, ~kjc, R1, 'g'^h(<'nx', ~e2, ~sf>),
                 'g'^(~sc.1*h(<'nx', ~e2, ~sf>))
         ) ▶₀ #i )
    case CS_1
    solve( V_St( ~vid, ~fid, ~e1, ~sv, ~kic.1, R1, Q1.1 ) ▶₀ #k )
      case V_1
      solve( !KU( h(<'d1', 
                     h(<'SK', 
